      "source": [
        "# Example code demonstrating Word2Vec, RNN, and LSTM implementations\n",
        "\n",
        "# =====================================================================\n",
        "# 1. Word2Vec Example (using Gensim)\n",
        "# =====================================================================\n",
        "from gensim.models import Word2Vec\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "# Sample corpus\n",
        "sentences = [\n",
        "    [\"the\", \"quick\", \"brown\", \"fox\", \"jumps\", \"over\", \"the\", \"lazy\", \"dog\"],\n",
        "    [\"i\", \"love\", \"natural\", \"language\", \"processing\"],\n",
        "    [\"word2vec\", \"rnn\", \"and\", \"lstm\", \"are\", \"popular\", \"nlp\", \"models\"]\n",
        "]\n",
        "\n",
        "# Train a Word2Vec model\n",
        "w2v_model = Word2Vec(sentences, vector_size=50, window=3, min_count=1, workers=1)\n",
        "word_vector = w2v_model.wv['nlp']\n",
        "print(\"Word2Vec Vector for 'nlp' (first 5 elements):\", word_vector[:5])\n",
        "\n",
        "# =====================================================================\n",
        "# 2. Simple RNN Example (using PyTorch)\n",
        "# =====================================================================\n",
        "# Parameters: input_size=10, hidden_size=20, num_layers=1\n",
        "input_size = 10\n",
        "hidden_size = 20\n",
        "seq_len = 5\n",
        "batch_size = 3\n",
        "\n",
        "# Initialize RNN\n",
        "rnn = nn.RNN(input_size=input_size, hidden_size=hidden_size, num_layers=1, batch_first=True)\n",
        "\n",
        "# Random input tensor: (batch_size, seq_len, input_size)\n",
        "inputs = torch.randn(batch_size, seq_len, input_size)\n",
        "\n",
        "# Forward pass\n",
        "out, h_n = rnn(inputs)\n",
        "print(\"\\nRNN Output Shape (batch_size, seq_len, hidden_size):\", out.shape)\n",
        "print(\"RNN Hidden State Shape (num_layers, batch_size, hidden_size):\", h_n.shape)\n",
        "\n",
        "# =====================================================================\n",
        "# 3. LSTM Example (using PyTorch)\n",
        "# =====================================================================\n",
        "# Initialize LSTM\n",
        "lstm = nn.LSTM(input_size=input_size, hidden_size=hidden_size, num_layers=1, batch_first=True)\n",
        "\n",
        "# Forward pass (returns output, and a tuple of (hidden_state, cell_state))\n",
        "out_lstm, (h_n_lstm, c_n_lstm) = lstm(inputs)\n",
        "print(\"\\nLSTM Output Shape:\", out_lstm.shape)\n",
        "print(\"LSTM Hidden State Shape:\", h_n_lstm.shape)\n",
        "print(\"LSTM Cell State Shape:\", c_n_lstm.shape)"
      ]
    },
