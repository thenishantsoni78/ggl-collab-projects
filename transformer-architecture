        "import matplotlib.pyplot as plt\n",
        "import matplotlib.patches as patches\n",
        "\n",
        "# Create a visual diagram of the 'window' concept and the 'vector_size' mapping\n",
        "fig, ax = plt.subplots(figsize=(12, 5))\n",
        "\n",
        "# Hide axes\n",
        "ax.axis('off')\n",
        "\n",
        "# Sample sentence\n",
        "words_list = [\"recurrent\", \"neural\", \"networks\", \"and\", \"lstm\", \"are\", \"used\"]\n",
        "target_idx = 2  # \"networks\" is the target word\n",
        "window_size = 2\n",
        "\n",
        "# Draw words and sliding window context\n",
        "for idx, w in enumerate(words_list):\n",
        "    # Highlight context words (within window of target_idx)\n",
        "    if idx == target_idx:\n",
        "        box_color = '#ff6b6b' # Target word: Red\n",
        "        text_style = {'weight': 'bold', 'color': 'white'}\n",
        "        label = \"Target Word\"\n",
        "    elif abs(idx - target_idx) <= window_size:\n",
        "        box_color = '#ffe066' # Context words: Yellow\n",
        "        text_style = {'weight': 'normal', 'color': 'black'}\n",
        "        label = \"Context\"\n",
        "    else:\n",
        "        box_color = '#e9ecef' # Outside window: Grey\n",
        "        text_style = {'weight': 'normal', 'color': '#adb5bd'}\n",
        "        label = \"Outside\"\n",
        "\n",
        "    # Draw bounding box for word\n",
        "    rect = patches.FancyBboxPatch((idx * 1.5, 3), 1.3, 0.8, boxstyle=\"round,pad=0.1\", fc=box_color, ec=\"gray\")\n",
        "    ax.add_patch(rect)\n",
        "    ax.text(idx * 1.5 + 0.65, 3.4, w, ha='center', va='center', fontsize=12, **text_style)\n",
        "    ax.text(idx * 1.5 + 0.65, 2.7, label, ha='center', va='center', fontsize=8, color='dimgray')\n",
        "\n",
        "# Arrow pointing to vector mapping\n",
        "ax.annotate('Neural Network\\nProjection', xy=(3.5, 1.2), xytext=(3.5, 2.4),\n",
        "            arrowprops=dict(facecolor='black', shrink=0.05, width=1.5, headwidth=8),\n",
        "            ha='center', fontsize=10, weight='bold')\n",
        "\n",
        "# Draw vector representation (vector_size)\n",
        "vector_rect = patches.Rectangle((1.5, 0.4), 4.5, 0.6, linewidth=1.5, edgecolor='#4dabf7', facecolor='#e7f5ff')\n",
        "ax.add_patch(vector_rect)\n",
        "ax.text(3.75, 0.7, \"Resulting dense vector (dimension = vector_size)\", ha='center', va='center', fontsize=11, color='#1c7ed6', weight='bold')\n",
        "\n",
        "# Draw indicators for indices\n",
        "for i in range(5):\n",
        "    val = [\"-0.12\", \"0.45\", \"...\", \"-0.89\", \"0.15\"][i]\n",
        "    ax.text(2.0 + i * 0.9, 0.1, val, ha='center', va='center', fontsize=9, color='black', weight='bold' if val != \"...\" else 'normal')\n",
        "\n",
        "plt.title(\"Visualizing Word2Vec Hyperparameters: 'window' and 'vector_size'\", fontsize=14, weight='bold', pad=20)\n",
        "plt.xlim(-0.5, 10.5)\n",
